# Environment variables for the app (no real secrets)
NEXT_PUBLIC_APP_URL=

# Optional Cloudflare Turnstile site key. Configure the secret in Supabase
# Auth → Attack Protection, not in the app.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Supabase project URL and public anon key (safe for the browser).
# Accounts are disabled when either value is unset.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "true" to enable the safe AI intake support assistant.
# Keep disabled on production until a real provider and full safety review are in place.
HELP_DESK_AI_ENABLED=false
NEXT_PUBLIC_AI_ENABLED=false
HELP_DESK_AI_PROVIDER=mock
HELP_DESK_AI_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
HELP_DESK_AI_DAILY_CALL_BUDGET=500
HELP_DESK_KNOWLEDGE_GOVERNANCE_ENABLED=false
# Enable deterministic, org-scoped knowledge-learning drafts after resolution.
HELP_DESK_KNOWLEDGE_LEARNING_ENABLED=false

# Provider timeout in milliseconds (default: 8000, clamped between 5000 and 10000).
HELP_DESK_AI_PROVIDER_TIMEOUT_MS=8000

# Max diagnostic questions returned in one response (default: 3, hard cap 3).
HELP_DESK_AI_MAX_DIAGNOSTIC_QUESTIONS=3

# Rate-limit provider for the AI endpoint.
# Options:
#   - upstash        real distributed limiter via Upstash Redis (recommended for production)
#   - memory        in-memory token bucket (safe for tests and Vercel previews only)
#   - disabled      skip in-app rate limiting when an upstream firewall handles it
#   - vercel-firewall  trust the managed Vercel Firewall rate limiter
# A managed rate limiter MUST be configured before enabling AI in production.
HELP_DESK_AI_RATE_LIMIT_PROVIDER=memory
HELP_DESK_AI_RATE_LIMIT_WINDOW_MS=60000
HELP_DESK_AI_RATE_LIMIT_MAX=30

# Upstash Redis credentials (required when using the upstash provider).
# The Vercel Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead;
# those are accepted as fallbacks.
# Create a free database at https://console.upstash.com and copy its REST URL
# and REST token from the database details page.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Service-role key — server-only, used by lib/supabase/admin.ts to send
# push notifications on behalf of a user from the ticket webhook.
# NEVER prefix this with NEXT_PUBLIC_. Find it in Supabase → Project
# Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret checked against the x-webhook-secret header on
# /api/push/ticket-webhook — set the same value in Supabase's Database
# Webhook config (Dashboard → Database → Webhooks).
SUPABASE_WEBHOOK_SECRET=

# Web Push VAPID keys — generate with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Enable the notification outbox and Brevo email delivery.
# Requires `supabase/notifications-sla.sql` and a free Brevo account
# (https://app.brevo.com — 300 emails/day, no expiry, no credit card).
# Brevo only requires verifying a single sender EMAIL ADDRESS (a
# confirmation link, no DNS/domain ownership needed) — unlike Resend,
# it can send to any real recipient without a custom domain.
# 1. Sign up at https://app.brevo.com and grab an API key under
#    Settings -> SMTP & API -> API Keys.
# 2. Go to Senders, Domains & Dedicated IPs -> Senders -> Add a Sender,
#    use an email you control (e.g. your Gmail), and click the
#    confirmation link Brevo emails you.
# 3. Set NOTIFICATIONS_FROM_EMAIL below to that exact verified address.
HELP_DESK_NOTIFICATIONS_ENABLED=false
BREVO_API_KEY=
NOTIFICATIONS_FROM_EMAIL=HelpDesk First <you@example.com>

# Secret for cron endpoints (attachments purge and notification dispatch).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Sentry error tracking. Leave NEXT_PUBLIC_SENTRY_DSN unset to disable.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Private operations export.
OPERATIONS_EXPORT_KEY=
OPERATIONS_PSEUDONYM_SALT=

# Secure role-based admin dashboard.
HELP_DESK_ADMIN_DASHBOARD_ENABLED=false
HELP_DESK_ADMIN_SESSION_SECRET=

# Enable ticket and AI resolution tracking after applying supabase/resolution-tracking.sql.
HELP_DESK_RESOLUTION_TRACKING_ENABLED=false
# Enable persisted AI investigation traces after applying supabase/investigation.sql.
HELP_DESK_INVESTIGATION_ENABLED=false
# Enable requester/staff risk and approval policy for troubleshooting steps.
HELP_DESK_STEP_POLICY_ENABLED=false
# Enable AI/employee ticket routing, conversations, verification, and SLA workflow.
HELP_DESK_TICKET_WORKFLOW_ENABLED=false
# Enable quarantined, scanned image/PDF attachments.
HELP_DESK_SECURE_ATTACHMENTS_ENABLED=false
HELP_DESK_ATTACHMENT_SCANNER=none
VIRUSTOTAL_API_KEY=
HELP_DESK_ATTACHMENT_RETENTION_DAYS=365
CRON_SECRET=
# Enable the requester-facing ticket portal after applying supabase/user-ticket-portal.sql.
HELP_DESK_USER_PORTAL_ENABLED=false
# Optional defense-in-depth MFA requirement for all admin sessions.
HELP_DESK_ADMIN_REQUIRE_MFA=false

# Optional Supabase OAuth providers. Enable only after configuring the
# provider client ID/secret in Supabase Authentication → Providers.
HELP_DESK_SSO_GOOGLE_ENABLED=false
HELP_DESK_SSO_MICROSOFT_ENABLED=false
