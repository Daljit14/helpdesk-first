# Environment variables for the app (no real secrets)
NEXT_PUBLIC_APP_URL=

# Supabase project URL and public anon key (safe for the browser).
# Accounts are disabled when either value is unset.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "true" to enable the safe AI intake support assistant.
# Keep disabled on production until a real provider and full safety review are in place.
HELP_DESK_AI_ENABLED=false
NEXT_PUBLIC_AI_ENABLED=false

# Provider timeout in milliseconds (default: 8000, clamped between 5000 and 10000).
HELP_DESK_AI_PROVIDER_TIMEOUT_MS=8000

# Max diagnostic questions returned in one response (default: 3, hard cap 3).
HELP_DESK_AI_MAX_DIAGNOSTIC_QUESTIONS=3

# Rate-limit provider for the AI endpoint.
# Options:
#   - memory        in-memory token bucket (safe for tests and Vercel previews only)
#   - disabled      skip in-app rate limiting when an upstream firewall handles it
#   - vercel-firewall  trust the managed Vercel Firewall rate limiter
# A managed rate limiter MUST be configured before enabling AI in production.
HELP_DESK_AI_RATE_LIMIT_PROVIDER=memory
HELP_DESK_AI_RATE_LIMIT_WINDOW_MS=60000
HELP_DESK_AI_RATE_LIMIT_MAX=30

# Placeholder for a future AI provider API key. Never expose this to the browser.
AI_PROVIDER_API_KEY=
